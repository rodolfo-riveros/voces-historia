# Copia este archivo como .env y completa tu clave.
# Sin clave, la app funciona en modo demo: solo responde las preguntas frecuentes de respaldo/.
# CON clave, la IA piensa y responde como el personaje cualquier pregunta.

# --- Opción A: DeepSeek (de pago, muy barato) — https://platform.deepseek.com ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Opción B: Gemini (tiene cuota gratuita) — clave en https://aistudio.google.com/apikey ---
# Comenta las 3 líneas de arriba y descomenta estas:
# DEEPSEEK_API_KEY=tu-clave-de-gemini
# DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEEPSEEK_MODEL=gemini-3.8-flash

# Tope de la respuesta (unas 4 oraciones caben de sobra en 400)
MAX_TOKENS=400
# 1 = DeepSeek "piensa" antes de responder (más lento: 4 a 10 s). 0 = responde directo (~2 s)
IA_RAZONAR=0
# Últimos mensajes que se envían al modelo (memoria de la conversación)
HISTORIAL_MAX=6
# Peticiones por IP por minuto
LIMITE_POR_MIN=20
# Peticiones totales al día; al llegar, se avisa con cortesía
TOPE_DIARIO=1500
# Segundos máximos de espera a la IA antes de usar el respaldo
TIMEOUT_IA=20
# Pon 1 para forzar el modo demo (sin IA) aunque haya clave
MODO_DEMO=0

# --- Voz a texto en el servidor (Whisper) ---
# Chrome usa su propio reconocimiento de voz; Edge, Brave, Firefox, Safari, etc. usan este.
# El audio se transcribe en memoria y se descarta: nunca se guarda.
STT_ACTIVO=1
# tiny (muy liviano), base (1–2 GB de RAM), small (4 GB o más: entiende mejor a los niños)
WHISPER_MODELO=base
# Núcleos de CPU que usa Whisper
WHISPER_HILOS=2
