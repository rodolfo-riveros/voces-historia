# Servicio systemd. Copiar a /etc/systemd/system/voces.service
# Ajusta User y las rutas si instalaste en otra carpeta.
[Unit]
Description=Voces de la Historia (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=voces
WorkingDirectory=/opt/voces
ExecStart=/opt/voces/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
